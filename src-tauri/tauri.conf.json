{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AccountBook",
  "version": "0.5.0",
  "identifier": "com.accountbook.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AccountBook",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzNEQwQjM2OTczMDIxQTEKUldTaElUQ1hOZ3ROd3grYkV2K0xCYndTMDIwVFY0aVlhZitXK2plL1pwQ3VkRVdqSGNDeDA4MSsK",
      "endpoints": [
        "https://github.com/JaK0B-Pro/Desktop-App/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
